---
import { Image } from "astro:assets";
import portrait from "../assets/ashish.png";
import { profile, stats } from "../data/portfolio";
---

<section id="about" class="relative mx-auto max-w-7xl px-5 py-28 sm:px-8 sm:py-36" aria-label="About">
	<div class="mb-14 flex items-baseline gap-6" data-reveal>
		<span class="font-mono text-xs tracking-widest text-accent">01</span>
		<h2 class="font-display text-4xl font-bold tracking-tight uppercase sm:text-6xl">About</h2>
		<span class="h-px flex-1 bg-line"></span>
	</div>

	<div class="grid gap-14 lg:grid-cols-[1.4fr_1fr] lg:gap-20">
		<div class="space-y-6 text-lg leading-relaxed text-muted sm:text-xl">
			{profile.bio.map((para) => <p data-reveal>{para}</p>)}

			<p data-reveal class="font-mono text-sm text-muted">
				<span class="text-accent">$</span> currently:
				<span class="text-paper">design systems @ {profile.company}</span>
				<span class="animate-blink text-accent">▊</span>
			</p>
		</div>

		<div class="space-y-10">
			<div class="group relative w-fit" data-reveal>
				<div class="absolute -inset-2 rounded-2xl border border-line transition-transform duration-500 group-hover:rotate-2"></div>
				<Image
					src={portrait}
					alt={`Portrait of ${profile.name}`}
					width={640}
					loading="lazy"
					class="relative aspect-square w-64 rounded-xl object-cover grayscale transition-[filter,scale] duration-500 group-hover:scale-[1.03] group-hover:grayscale-0 sm:w-80"
				/>
				<span class="absolute -right-3 -bottom-3 rounded-full bg-paper px-3 py-1 font-mono text-xs font-semibold text-ink">
					home cook · music buff
				</span>
			</div>

			<div class="rounded-xl border border-line bg-ink-2 p-6 font-mono text-sm" data-reveal>
				<p class="mb-5 flex items-center justify-between text-xs tracking-widest text-muted uppercase">
					<span>// stats</span>
					<span class="flex gap-1.5" aria-hidden="true">
						<span class="h-2 w-2 rounded-full bg-line"></span>
						<span class="h-2 w-2 rounded-full bg-line"></span>
						<span class="h-2 w-2 rounded-full bg-accent"></span>
					</span>
				</p>
				<dl class="space-y-3.5">
					{
						stats.map((stat) => (
							<div class="flex items-baseline justify-between gap-6">
								<dt class="text-muted">
									<span class="text-accent">$</span> {stat.label}
								</dt>
								<dd class="font-semibold text-paper">
									<span data-count={stat.value}>{stat.value}</span><span class="text-accent">{stat.suffix}</span>
								</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</div>
</section>
