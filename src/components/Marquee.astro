---
import { skills } from "../data/portfolio";
---

<div class="marquee overflow-hidden border-y border-line py-5" aria-hidden="true">
	<div class="marquee-track gap-0">
		{
			[0, 1].map(() => (
				<div class="flex shrink-0 items-center">
					{skills.map((skill) => (
						<span class="flex items-center font-display text-2xl font-bold tracking-tight whitespace-nowrap uppercase sm:text-3xl">
							<span class="px-6 text-paper/90">{skill}</span>
							<span class="text-accent">✦</span>
						</span>
					))}
				</div>
			))
		}
	</div>
</div>
