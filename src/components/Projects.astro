---
import { projects } from "../data/portfolio";

const statusStyles: Record<string, string> = {
	"open source": "text-accent border-accent/40",
	live: "text-accent border-accent/40",
	maintained: "text-paper border-paper/30",
	wip: "text-muted border-line",
	archived: "text-muted/60 border-line line-through",
};
---

<section id="projects" class="mx-auto max-w-7xl px-5 py-28 sm:px-8 sm:py-36" aria-label="Projects">
	<div class="mb-14 flex items-baseline gap-6" data-reveal>
		<span class="font-mono text-xs tracking-widest text-accent">03</span>
		<h2 class="font-display text-4xl font-bold tracking-tight uppercase sm:text-6xl">Projects</h2>
		<span class="h-px flex-1 bg-line"></span>
	</div>

	<ul class="border-t border-line">
		{
			projects.map((project, i) => (
				<li data-reveal class="border-b border-line">
					<a
						href={project.deployed ?? project.github}
						target="_blank"
						rel="noopener"
						class="group grid gap-x-8 gap-y-4 py-10 transition-colors duration-300 hover:bg-ink-2/60 sm:grid-cols-[4rem_1fr_auto] sm:px-4 sm:py-12"
					>
						<span class="font-mono text-xs text-muted pt-2 sm:pt-4">/0{i + 1}</span>
						<div class="min-w-0">
							<h3 class="font-display text-[clamp(2rem,5vw,3.75rem)] leading-none font-bold tracking-tight text-paper [overflow-wrap:anywhere] transition-all duration-300 group-hover:translate-x-2 group-hover:text-accent">
								{project.name}
							</h3>
							<p class="mt-4 max-w-xl leading-relaxed text-muted">{project.desc}</p>
							<ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1" aria-label="Built with">
								{project.tech.map((tech) => (
									<li class="font-mono text-xs text-muted transition-colors group-hover:text-paper/70">
										{tech}
									</li>
								))}
							</ul>
						</div>
						<div class="flex items-center justify-between gap-6 sm:flex-col sm:items-end sm:justify-start sm:gap-5 sm:pt-2">
							<span
								class:list={[
									"rounded-full border px-3 py-1 font-mono text-[0.65rem] tracking-widest whitespace-nowrap uppercase",
									statusStyles[project.status],
								]}
							>
								{project.status}
							</span>
							<span
								aria-hidden="true"
								class="text-3xl leading-none text-muted transition-all duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-accent"
							>
								↗
							</span>
						</div>
					</a>
				</li>
			))
		}
	</ul>

	<p class="mt-8 text-right font-mono text-sm text-muted" data-reveal>
		more experiments on
		<a href="https://github.com/afkcodes" target="_blank" rel="noopener" class="link-sweep text-paper">github ↗</a>
	</p>
</section>
