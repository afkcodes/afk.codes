---
import Base from "../layouts/Base.astro";
---

<Base title="404 — Ashish Kumar" description="This page went AFK.">
	<main class="flex min-h-svh flex-col items-center justify-center gap-6 px-5 text-center">
		<p class="font-mono text-sm tracking-widest text-accent uppercase">error 404</p>
		<h1 class="font-display text-6xl font-extrabold tracking-tight uppercase sm:text-8xl">
			gone <span class="text-outline">afk</span>
		</h1>
		<p class="max-w-md text-muted">
			This page stepped away from the keyboard and never came back.
		</p>
		<a
			href="/"
			class="mt-4 rounded-full bg-paper px-7 py-3.5 font-mono text-sm font-semibold text-ink transition-[scale] duration-300 hover:scale-105"
		>
			← back home
		</a>
	</main>
</Base>
